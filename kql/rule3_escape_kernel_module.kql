// RULE 3   Container escape: kernel module loaded from a container
//   Severity High | Tactics: Privilege Escalation, Persistence | T1547.006, T1611
//   Run every 5 min, lookup 30 min, threshold > 0, group all events into ONE alert,
//   suppression 30 min.
//   Entity mapping: Host -> HostName = Host
//   Custom details: Pod, Stages, Modules, Commands, ReconComplete
//   Required: the module load only. Everything else is evidence.
Wazuh_Falco_Alerts
| where IngestTime > ago(30m)
| where Stage != ""
| order by EventTime asc
| summarize
    FirstSeen         = min(EventTime),
    LastSeen          = max(EventTime),
    Stages            = make_set(Stage),
    T_Module          = minif(EventTime, Stage == "3-KernelModule"),
    T_KernelRecon     = minif(EventTime, Stage == "0-KernelRecon"),
    T_NetRecon        = minif(EventTime, Stage == "0-NetRecon"),
    SawModuleListRead = countif(Stage == "0-ModuleListRead") > 0,
    SawToolTransfer   = countif(Stage == "0-ToolTransfer") > 0,
    SawShell          = countif(Stage == "1-Shell") > 0,
    SawPrivEsc        = countif(Stage == "2-PrivEsc") > 0,
    SawExecPerm       = countif(Stage == "2-ExecPerm") > 0,
    Pods              = make_set_if(Pod, isnotempty(Pod), 10),
    Modules           = make_set_if(CmdLine, Stage == "3-KernelModule", 10),
    Commands          = make_list_if(CmdLine, isnotempty(CmdLine), 25)
    by Host
| where isnotnull(T_Module)
| extend ReconComplete = isnotnull(T_KernelRecon) and isnotnull(T_NetRecon)
                         and T_KernelRecon <= T_Module and T_NetRecon <= T_Module,
         Pod = tostring(Pods[0]),
         ChainLength = array_length(Stages),
         TimeGenerated = LastSeen
