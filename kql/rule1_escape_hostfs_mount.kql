Wazuh_Falco_Alerts
| where IngestTime > ago(30m)
| where Stage != ""
| order by EventTime asc
| summarize
    FirstSeen         = min(EventTime),
    LastSeen          = max(EventTime),
    Stages            = make_set(Stage),
    T_Shell           = minif(EventTime, Stage == "1-Shell"),
    T_HostFS          = minif(EventTime, Stage == "3-HostFS"),
    T_KernelRecon     = minif(EventTime, Stage == "0-KernelRecon"),
    T_NetRecon        = minif(EventTime, Stage == "0-NetRecon"),
    SawMountTableRead = countif(Stage == "0-MountTableRead") > 0,
    SawPrivEsc        = countif(Stage == "2-PrivEsc") > 0,
    SawToolTransfer   = countif(Stage == "0-ToolTransfer") > 0,
    SawChroot         = countif(Stage == "3-Chroot") > 0,
    ChrootTargets     = make_set_if(ChrootPath, Stage == "3-Chroot" and isnotempty(ChrootPath), 10),
    Pods              = make_set_if(Pod, isnotempty(Pod), 10),
    Mounts            = make_set_if(strcat(MountSrc, " -> ", MountTarget), Stage == "3-HostFS" and isnotempty(MountSrc), 10),
    ContainerIds      = make_set_if(ContainerId, isnotempty(ContainerId), 5),
    Pids              = make_set_if(Pid, Stage in ("3-HostFS", "3-Chroot", "5-Listener"), 10),
    Commands          = make_list_if(CmdLine, isnotempty(CmdLine), 25)
    by Host
| where isnotnull(T_HostFS) and isnotnull(T_Shell)
| where T_Shell <= T_HostFS                          
| extend ReconComplete = isnotnull(T_KernelRecon) and isnotnull(T_NetRecon)
                         and T_KernelRecon <= T_HostFS and T_NetRecon <= T_HostFS,
         Pod = tostring(Pods[0]),
         ChainLength = array_length(Stages),
         TimeGenerated = LastSeen
